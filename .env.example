# atomno-mcp-zakupki — пример конфигурации
# По умолчанию источник — официальный сайт zakupki.gov.ru. Ключ не нужен.

# --- Логирование ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
MCP_ZAKUPKI_LOG_LEVEL=INFO

# --- Кэш ---
# По умолчанию — каталог данных пользователя (%LOCALAPPDATA%/atomno/ или ~/.local/share/atomno/).
# MCP_ZAKUPKI_CACHE_DB=

# --- Цепочка источников (default: eis_public) ---
# MCP_ZAKUPKI_PROVIDERS=eis_public
# Покупной посредник только явно и в конце, если есть рабочий ключ:
# MCP_ZAKUPKI_PROVIDERS=eis_public,damia

# --- DaMIA API-Закупки (отключён по умолчанию) ---
# MCP_ZAKUPKI_DAMIA_KEY=

# --- ГосПлан API v2 ---
# MCP_ZAKUPKI_GOSPLAN_KEY=
# MCP_ZAKUPKI_GOSPLAN_BASE=https://v2.gosplan.info

# --- navodki.ru ---
# MCP_ZAKUPKI_NAVODKI_KEY=

# --- SOAP ЕИС (токен после регистрации на портале) ---
# MCP_ZAKUPKI_EIS_TOKEN=
# MCP_ZAKUPKI_EIS_BASE=https://int.zakupki.gov.ru/eis-integration/services

# --- Hosted ---
# MCP_ZAKUPKI_ATOMNO_API_KEY=
# (алиас: MCP_ZAKUPKI_API_KEY)

# --- Лимиты ---
# MCP_ZAKUPKI_RPS=30
